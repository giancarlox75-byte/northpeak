# ---------- Required ----------
# Long random string that signs admin login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Database (required in production) ----------
# Neon Postgres connection string. Leave blank locally to use data.json.
DATABASE_URL=

# ---------- Admin setup from the browser (optional) ----------
# Set this, visit /setup?key=YOUR_KEY to create your login, then delete it.
SETUP_KEY=

# ---------- Email via Resend (optional, recommended) ----------
RESEND_API_KEY=
# Where alerts for new messages/volunteers go (comma-separate for several)
NOTIFY_EMAIL=
# Sender. Must be on a domain you've verified in Resend to email the public.
MAIL_FROM=Team Reece <hello@teamreece.com>
# 1 = also send confirmation/welcome emails to people who sign up (needs a verified domain)
SEND_CONFIRMATIONS=0

# Public site address, used in unsubscribe links (e.g. https://teamreece.com)
SITE_URL=
